@PACKAGE_INIT@

# Make sure this is set before anything pulls in Qt6Qml transitively (e.g. via
# KF6XmlGui) — some Qt6Qml CMake versions unconditionally reference it while
# defining their versionless convenience functions.
if(NOT DEFINED QT_DEFAULT_MAJOR_VERSION)
    set(QT_DEFAULT_MAJOR_VERSION 6)
endif()

include(CMakeFindDependencyMacro)

# Only the *public* (usage-requirement) dependencies of the exported libraries need to
# be found here — i.e. the ones whose types show up in installed headers. Private
# dependencies are already linked into the corresponding .so and don't need to be
# visible to consumers at configure time.
find_dependency(Qt6Core @REQUIRED_QT_VERSION@)
find_dependency(Qt6Gui @REQUIRED_QT_VERSION@)
find_dependency(Qt6Widgets @REQUIRED_QT_VERSION@)
find_dependency(Qt6Xml @REQUIRED_QT_VERSION@)
find_dependency(Qt6PrintSupport @REQUIRED_QT_VERSION@)
find_dependency(KF6I18n @REQUIRED_KF6_VERSION@)
find_dependency(KF6XmlGui @REQUIRED_KF6_VERSION@)
find_dependency(KF6KIO @REQUIRED_KF6_VERSION@)

# Optional public dependencies of pigmentcms — only present if this Calligra was
# itself built with them.
set(CalligraQt6_HAVE_OPENEXR @HAVE_OPENEXR@)
if(CalligraQt6_HAVE_OPENEXR)
    find_dependency(Imath 3.0)
endif()
set(CalligraQt6_HAVE_VC @HAVE_VC@)
if(CalligraQt6_HAVE_VC)
    find_dependency(Vc)
endif()

# The libraries this package can provide. Every one of them is always built and
# installed together (there's no way to install e.g. just "flake" on its own), so
# requesting a component only affects what find_package() checks/reports on; the
# same shared CalligraQt6Targets.cmake is included regardless of what was asked for,
# so a library's own internal dependencies (e.g. flake needing pigmentcms) are always
# available too, however they were reached.
set(_CalligraQt6_known_components
    flake
    pigmentcms
    koodf
    kowidgetutils
    kundo2
    kostore
    interfaces
)

foreach(_comp ${CalligraQt6_FIND_COMPONENTS})
    if(NOT _comp IN_LIST _CalligraQt6_known_components)
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
            "Unknown CalligraQt6 component \"${_comp}\". Known components: ${_CalligraQt6_known_components}")
        return()
    endif()
    set(CalligraQt6_${_comp}_FOUND TRUE)
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/CalligraQt6Targets.cmake")

check_required_components(CalligraQt6)
