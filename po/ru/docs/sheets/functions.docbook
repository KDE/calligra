><segtitle
>Тип</segtitle>
<seglistitem
><seg
>ставка</seg
><seg
>Вещественное число (1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>периоды</seg
><seg
>Вещественное число (1.3, 0.343, 253)</seg
