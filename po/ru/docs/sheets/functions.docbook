<varlistentry
><term
>Примеры</term>
<listitem
><para
>TANH(0) равняется 0</para
></listitem>
</varlistentry>
<varlistentry
><term
>См. также</term>
<listitem
><simplelist>
<member
><link linkend="ATANH"
>ATANH</link
>&nbsp;</member>
</simplelist
></listitem>
</varlistentry>
</variablelist>
</sect3>

</sect2>
</sect1>
</chapter>
 

