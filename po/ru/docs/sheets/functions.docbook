><seg
>Текст</seg
></seglistitem>
<seglistitem
><seg
>Минимальная длина выходного значения</seg
><seg
>Целое число (1, 132, 2344)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>OCT2BIN("12") возвратит "1010"</para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>OCT2BIN("55") возвратит "101101"</para
></listitem>
</varlistentry>
</variablelist>
</sect3>

