><para
><segmentedlist
><segtitle
>Комментарий</segtitle
><segtitle
>Тип</segtitle>
<seglistitem
><seg
>Любое значение</seg
><seg
>Любой вид значения</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
