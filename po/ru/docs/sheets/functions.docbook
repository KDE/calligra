></listitem>
</varlistentry>
<varlistentry
><term
>Параметры</term>
<listitem
><para
><segmentedlist
><segtitle
>Комментарий</segtitle
><segtitle
>Тип</segtitle>
<seglistitem
><seg
>Угол (в радианах)</seg
><seg
>Вещественное число (1.3, 0.343, 253)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>ATANH(0.8) равняется 1.09861229</para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>ATANH(0) равняется 0</para
></listitem>
</varlistentry>
<varlistentry
><term
>См. также</term>
