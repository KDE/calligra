><term
>Параметры</term>
<listitem
><para
><segmentedlist
><segtitle
>Комментарий</segtitle
><segtitle
>Тип</segtitle>
<seglistitem
><seg
>Минимум</seg
><seg
>Целое число (1, 132, 2344)</seg
></seglistitem>
<seglistitem
><seg
>Максимум</seg
><seg
>Целое число (1, 132, 2344)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>RANDBETWEEN(12;78) может возвратить 61.0811...</para
></listitem>
</varlistentry>
<varlistentry
><term
>См. также</term>
<listitem
><simplelist>
<member
><link linkend="RAND"
>RAND</link
>&nbsp;</member>
</simplelist
></listitem>
</varlistentry>
</variablelist>
</sect3>

