<varlistentry
><term
>Синтаксис</term>
<listitem
><para
>GCD(value; value)</para
></listitem>
</varlistentry>
<varlistentry
><term
>Параметры</term>
<listitem
><para
><segmentedlist
><segtitle
>Комментарий</segtitle
><segtitle
>Тип</segtitle>
<seglistitem
><seg
>Первое число</seg
><seg
>Целые числа (1, 132, 2344)</seg
></seglistitem>
<seglistitem
><seg
>Второе число</seg
><seg
>Целые числа (1, 132, 2344)</seg
></seglistitem>
<seglistitem
><seg
>Третье число</seg
><seg
>Целые числа (1, 132, 2344)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>GCD(6;4) возвратит 2</para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>GCD(10;20) возвратит 10</para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>GCD(20;15;10) возвратит 5</para
></listitem>
</varlistentry>
<varlistentry
><term
>См. также</term>
<listitem
><simplelist>
<member
><link linkend="LCM"
>LCM</link
>&nbsp;</member>
</simplelist
></listitem>
</varlistentry>
</variablelist>
</sect3>

