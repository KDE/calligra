><para
><segmentedlist
><segtitle
>Комментарий</segtitle
><segtitle
>Тип</segtitle>
<seglistitem
><seg
>Вещественное число</seg
><seg
>Вещественное число (1.3, 0.343, 253)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
