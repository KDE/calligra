</varlistentry>
<varlistentry
><term
>Параметры</term>
<listitem
><para
><segmentedlist
><segtitle
>Комментарий</segtitle
><segtitle
>Тип</segtitle>
<seglistitem
><seg
>Любое значение</seg
><seg
>Любой вид значения</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>ISLOGICAL(A1
>A2) возвратит True</para
></listitem>
