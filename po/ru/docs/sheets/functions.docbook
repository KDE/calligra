></listitem>
</varlistentry>
<varlistentry
><term
>Примеры</term>
<listitem
><para
>CUMPRINC( 0.06/12; 5*12; 100000; 5; 12; 0 ) равняется -11904.054201</para
></listitem>
</varlistentry>
<varlistentry
