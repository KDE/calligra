><seg
>عائم</seg
><seg
>مزدوج</seg
></seglistitem>
<seglistitem
><seg
>عائم</seg
><seg
>مزدوج</seg
></seglistitem>
<seglistitem
><seg
>عائم</seg
><seg
>مزدوج</seg
></seglistitem>
<seglistitem
><seg
>عائم</seg
><seg
>مزدوج</seg
