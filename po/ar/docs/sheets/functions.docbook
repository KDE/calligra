>TBILLPRICE(تسوية؛ استحقاق؛ خصم)</para
></listitem>
</varlistentry>
<varlistentry
><term
>المعاملات</term>
<listitem
><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
><seg
>تاريخ التسوية</seg
><seg
>تاريخ</seg
></seglistitem>
<seglistitem
><seg
>الاستحقاق</seg
><seg
>تاريخ</seg
