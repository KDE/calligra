><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
><seg
>P</seg
><seg
>عدد صحيح (مثل 1، 132، 2344)</seg
></seglistitem>
<seglistitem
><seg
>Pv</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>Fv</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>RRI(1;100;200) يُرجع 1</para
></listitem>
</varlistentry>
