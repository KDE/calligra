><segtitle
>النوع</segtitle>
<seglistitem
><seg
>عائم</seg
><seg
>مزدوج</seg
></seglistitem>
<seglistitem
><seg
>عائم</seg
><seg
>مزدوج</seg
></seglistitem>
<seglistitem
><seg
>عائم</seg
><seg
>مزدوج</seg
></seglistitem>
<seglistitem
><seg
>عائم</seg
><seg
>مزدوج</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
