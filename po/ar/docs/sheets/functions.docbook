<varlistentry
><term
>الصياغة</term>
<listitem
><para
>CARX(نصف_القطر;زاوية)</para
></listitem>
</varlistentry>
<varlistentry
><term
>المعاملات</term>
<listitem
><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
