><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
><seg
>الدولار الكسري</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>الكسر</seg
><seg
>عدد صحيح (مثل 1، 132، 2344)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>DOLLARDE(1.02; 16) - يمثل 1 و 2/16 - يُرجع 1.125</para
></listitem>
</varlistentry>
<varlistentry
><term
>الدوال ذات الصلة</term>
<listitem
