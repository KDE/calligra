><seg
>سعر الفائدة</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>القيمة الحالية (PV)</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>القيمة المستقبلية (FV)</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
