><seg
>مزدوج</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>ترجع CARX(12;1.5707) 0.00115592</para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>ترجع CARX(12;0) 12</para
></listitem>
</varlistentry>
<varlistentry
><term
>الدوال ذات الصلة</term>
<listitem
><simplelist>
<member
><link linkend="CARY"
>CARY</link
>&nbsp;</member>
<member
