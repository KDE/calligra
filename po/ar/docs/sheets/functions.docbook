><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
><seg
>سعر الفائدة</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>القيم (مصفوفة)</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
