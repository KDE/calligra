></listitem>
</varlistentry>
<varlistentry
><term
>المعاملات</term>
<listitem
><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
><seg
>تاريخ التسوية</seg
><seg
>تاريخ</seg
></seglistitem>
<seglistitem
><seg
>الاستحقاق</seg
><seg
>تاريخ</seg
></seglistitem>
<seglistitem
><seg
>التكرار</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>أساس عد الأيام</seg
><seg
>عدد صحيح (مثل 1، 132، 2344)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>COUPNUM("2/28/2001"; "8/31/2001"; 2; 0) ترجع 1</para
></listitem>
</varlistentry>
</variablelist>
</sect3>

