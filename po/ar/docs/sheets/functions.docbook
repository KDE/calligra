<seglistitem
><seg
>تاريخ التسوية</seg
><seg
>تاريخ</seg
></seglistitem>
<seglistitem
><seg
>السعر السنوي للورقة المالية</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>القيمة الاسمية</seg
><seg
>قيمة فاصلة عائمة (مثل 1.3, 0.343, 253)</seg
></seglistitem>
<seglistitem
><seg
>أساس عد الأيام</seg
><seg
>عدد صحيح (مثل 1، 132، 2344)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>ACCRINTM("2/28/2001"; "8/31/2001"; 0.1; 100) تُرجع 5.0278</para
></listitem>
</varlistentry>
<varlistentry
