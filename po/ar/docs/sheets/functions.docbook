<varlistentry
><term
>أمثلة</term>
<listitem
><para
>CUMPRINC( 0.06/12; 5*12; 100000; 5; 12; 0 ) تساوي -11904.054201</para
></listitem>
</varlistentry>
<varlistentry
><term
>الدوال ذات الصلة</term>
<listitem
><simplelist>
<member
><link linkend="PPMT"
>PPMT</link
>&nbsp;</member>
