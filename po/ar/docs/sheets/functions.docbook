></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>ATANH(0) يساوي 0</para
></listitem>
</varlistentry>
<varlistentry
><term
>الدوال ذات الصلة</term>
<listitem
