<listitem
><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
><seg
>القيمة السفلية</seg
><seg
>عدد صحيح (مثل 1، 132، 2344)</seg
></seglistitem>
<seglistitem
><seg
>القيمة العلوية</seg
><seg
>عدد صحيح (مثل 1، 132، 2344)</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
>RANDBETWEEN(12;78) تساوي مثلًا 61.0811...</para
></listitem>
</varlistentry>
<varlistentry
><term
>الدوال ذات الصلة</term>
<listitem
><simplelist>
<member
><link linkend="RAND"
