<listitem
><para
><segmentedlist
><segtitle
>تعليق</segtitle
><segtitle
>النوع</segtitle>
<seglistitem
><seg
>أي قيمة</seg
><seg
>أي نوع من القيم</seg
></seglistitem
></segmentedlist
></para
></listitem>
</varlistentry>
<varlistentry
><term
>أمثلة</term>
<listitem
><para
